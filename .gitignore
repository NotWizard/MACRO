# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Data (runtime / cache / downloaded files)
data/*.db
data/*.db.staging
# WAL 边车：`data/*.db` 匹配不到 `macro_data.db-wal`（后缀不是 .db 结尾），
# 开启 journal_mode=WAL 后这两个文件会常驻，必须显式忽略。
data/*.db-wal
data/*.db-shm
data/*.csv
data/backups/
# vintage 快照默认不入库（体积大、可重生）；但破例白名单本次 NBS 修复后的库快照
# （首次含 fiscal/external_demand/household_income 三表），按用户要求纳入版本。
# 注意：必须忽略"目录内容"(data/vintages/*)而非"目录"(data/vintages/)，否则白名单不生效。
data/vintages/*
!data/vintages/macro_data_20260824_181018.db
data/last_run.json
data/ai_config.json*
data/.dashcache/
# 单飞锁：宏观刷新用 .refresh.lock、CRCL 采集用 .crcl_collect.lock（G09 新增），
# 都是 flock 的运行期文件，用通配一并忽略，避免每次跑完冒出未跟踪文件。
data/*.lock
# 本机能力令牌（启动时随机生成，0600）——变更端点的 CSRF 防护凭据，绝不入库。
data/.api_token
data/refresh_schedule.log
# 运行期日志目录（run_app.sh 的 api.log、01_fetch_data.py 的 fetch.log）。
# 根忽略此前只列了具体的 data/* 条目、未覆盖该目录，run_app.sh 只能在创建目录时
# 顺手写一个自忽略的 data/logs/.gitignore 兜底；补在这里让根文件成为唯一权威。
data/logs/

# IDE
.idea/
.vscode/
*.swp
.codegraph/
.qoder/

# OS
.DS_Store
Thumbs.db

# Environment
.env
.venv/
.venv312/
env/
venv/

# Frontend build artifacts
# ponytail: no-trailing-slash duplicate covers the worktree case where
# node_modules is a symlink (git sees a file, so "dir/" patterns don't match)
frontend/node_modules
frontend/node_modules/
frontend/dist/

# Worktrees
.worktrees/

# 子 Agent 验证用临时草稿目录（不入库）
.scratch/

# Scratch / untracked artifacts (audit O-M4/O-M5: screenshots, external MCP output,
# orphaned backtest analysis unrelated to the macro platform)
.playwright-mcp/
backtest_hshylv/
x-ai-news-search.png
x-claude-search.png
